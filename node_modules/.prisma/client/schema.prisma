datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       Role     @default(VIEWER)
  totpSecret String?
  mfaEnabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Profile {
  id           Int      @id @default(1)
  companyName  String
  companyDesc  String
  founderName  String
  founderDesc  String
  phone        String
  whatsapp     String
  address      String
  email        String
  logoUrl      String?
  faviconUrl   String?
  instagramUrl String?
  tiktokUrl    String?
  tokopediaUrl String?
  shopeeUrl    String?
  facebookUrl  String?
  updatedAt    DateTime @updatedAt
}

model Hero {
  id           Int      @id @default(1)
  title        String
  subtitle     String
  description  String
  imageUrl     String?
  hashtags     String[]
  headerCta    String?
  buttonCta    String?
  buyButtonCta String?
}

model IngredientSection {
  id       Int    @id @default(1)
  title    String
  subtitle String
}

model IngredientItem {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  icon        String
  link        String?
  order       Int     @default(0)
}

model BenefitSection {
  id       Int     @id @default(1)
  title    String
  subtitle String
  ctaText  String?
  ctaLink  String?
}

model BenefitItem {
  id          Int     @id @default(autoincrement())
  icon        String
  title       String
  description String
  link        String?
  order       Int     @default(0)
}

model ProductSection {
  id          Int     @id @default(1)
  title       String
  subtitle    String
  imageUrl    String?
  quote       String?
  description String?
}

model ProductStat {
  id    Int    @id @default(autoincrement())
  value String
  unit  String
  label String
  order Int    @default(0)
}

model UpgradeFAQSection {
  id       Int    @id @default(1)
  title    String
  subtitle String
}

model UpgradeItem {
  id          Int     @id @default(autoincrement())
  icon        String
  title       String
  description String
  link        String?
  order       Int     @default(0)
}

model FAQItem {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  order    Int    @default(0)
}

model WhereToFindSection {
  id       Int    @id @default(1)
  title    String
  subtitle String
}

model PlatformItem {
  id          Int     @id @default(autoincrement())
  platform    String // Instagram, Tokopedia, Shopee, TikTok, Lazada, Facebook
  title       String
  description String
  link        String
  imageUrl    String?
  order       Int     @default(0)
}

model Footer {
  id          Int     @id @default(1)
  title       String
  subtitle    String
  description String
  ctaText     String?
  ctaLink     String?
}

model AnalyticsClick {
  id        Int      @id @default(autoincrement())
  buttonId  String
  pagePath  String
  timestamp DateTime @default(now())
}
